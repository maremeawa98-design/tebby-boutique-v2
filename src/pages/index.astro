---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import ProductCard from '../components/ProductCard.astro';
import { COUVERTURES, cropPosition, focus } from '../lib/cadrage';
import { getCatalogue } from '../lib/catalogue';
import { fcfa } from '../lib/format';
import { shareImage } from '../lib/partage';

const { products, rubriques, univers, rates } = await getCatalogue();
const find = (slug: string) => products.find((p) => p.slug === slug) ?? products[0];
const prices = products.map((p) => p.price);
const minPrice = fcfa(Math.min(...prices));
const maxPrice = fcfa(Math.max(...prices));
const cheapestDelivery = fcfa(Math.min(...rates.map((r) => r.fee)));
const sales = import.meta.env.PUBLIC_WHATSAPP_SALES;

const from = (slug: string) => {
  const slugs = univers.find((u) => u.slug === slug)?.rubriques ?? [];
  return fcfa(Math.min(...rubriques.filter((r) => slugs.includes(r.slug)).map((r) => r.from)));
};
const femme = find('robe-longue-ivoire-sans-manches');
const homme = find('costume-africain-noir');
const selection = ['robe-midi-bleu-marine-cintree', 'costume-africain-rose', 'ensemble-confort-vert-foret', 'tunique-prune-et-pantalon-clair', 'ensemble-noir', 'ensemble-vert-femme', 'jupe-evasee-marron-a-boutons', 'ensemble-marron-raye'].map(find);
const duo = rubriques.find((r) => r.slug === 'ensembles-homme-femme');
const couleur = (name: string) => {
  const mot = name.split(' ').at(-1)!;
  return mot[0].toUpperCase() + mot.slice(1);
};

// Une rubrique rattachée à plusieurs univers n'apparaît que dans le dernier.
const colonnes = await Promise.all(
  univers.map(async (u) => ({
    name: u.name,
    href: `/boutique/${u.slug}`,
    rubriques: await Promise.all(
      rubriques
        .filter((r) => univers.filter((x) => x.rubriques.includes(r.slug)).at(-1) === u)
        .map(async (r) => {
          const cover = r.products.find((p) => p.slug === COUVERTURES[r.slug]) ?? r.products[0];
          const image = await getImage({ src: cover.image, width: 480, height: 640, fit: 'cover', position: cropPosition(cover), format: 'webp' });
          return { ...r, cover, photo: image.src };
        }),
    ),
  })),
);

const share = await shareImage(femme);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ClothingStore',
  name: 'TEBBY',
  slogan: 'La marque qui rassure',
  url: new URL('/', Astro.site).href,
  telephone: '+221781898385',
  image: new URL(share, Astro.site).href,
  priceRange: `${minPrice} à ${maxPrice}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Petit Mbao', addressCountry: 'SN' },
};
---
<Base
  title="TEBBY | La marque qui rassure"
  description={`Robes, ensembles et costumes de ${minPrice} à ${maxPrice}. Choisissez en ligne, TEBBY confirme avec vous sur WhatsApp. Paiement à la livraison ou par Wave.`}
  image={share}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />

  <div class="intro" id="intro" aria-hidden="true">
    <svg viewBox="0 0 400 120"><text x="200" y="88" text-anchor="middle">TEBBY</text></svg>
  </div>
  <script is:inline>
    // Elle se joue à chaque arrivée sur le site et à chaque rechargement,
    // mais pas quand on revient à l'accueil depuis une autre page du site.
    (() => {
      const type = performance.getEntriesByType('navigation')[0]?.type;
      const interne = document.referrer.startsWith(location.origin);
      if (type === 'back_forward' || (type === 'navigate' && interne)) document.getElementById('intro').remove();
    })();
  </script>

  <div class="accueil">
    <svg class="fil" id="fil" aria-hidden="true">
      <path class="ombre" id="fil-ombre"></path>
      <path id="fil-or"></path>
      <circle class="aiguille" id="aiguille" r="3.5"></circle>
    </svg>

    <section class="hero" data-fil="0.5 0; 0.985 0.12; 0.7 0.5; 0.3 0.86" data-fil-m="0.985 0; 0.985 0.5; 0.6 0.72; 0.3 0.84">
      <div>
        <p class="lieu">Petit Mbao, Sénégal</p>
        <h1>Vos plus belles tenues, dès <em>{minPrice}.</em></h1>
        <p class="chapo">Robes, ensembles et costumes, pour tous les jours comme pour les grandes occasions.</p>
      </div>
      <div class="tiles">
        <a class="tile" href="/boutique/femme">
          <figure data-revele><Photo src={femme.image} alt={femme.name} sizes="(min-width: 900px) 26vw, 48vw" eager style={`object-position: ${focus(femme)}`} /></figure>
          <span class="etiquette"><b>Femme</b><span>dès {from('femme')}</span></span>
        </a>
        <a class="tile" href="/boutique/homme">
          <figure data-revele><Photo src={homme.image} alt={homme.name} sizes="(min-width: 900px) 26vw, 48vw" eager style={`object-position: ${focus(homme)}`} /></figure>
          <span class="etiquette"><b>Homme</b><span>dès {from('homme')}</span></span>
        </a>
      </div>
    </section>

    <ul class="assure" data-fil="0.012 0.5">
      <li><b>Payez à la livraison</b><span>ou par Wave</span></li>
      <li><b>Confirmation sur WhatsApp</b><span>avant tout paiement</span></li>
      <li><b>Livraison dès {cheapestDelivery}</b><span>banlieue, Dakar, régions</span></li>
      <li><b>Du S au XXL</b><span>sur tous les vêtements</span></li>
    </ul>

    <section class="moment" id="moment" data-fil="0.012 0.02; 0.988 0.98">
      <div class="scene">
        <div>
          <header class="moment-tete">
            <h2 data-monte>Les tenues du moment</h2>
            <a href="/boutique">Tout voir</a>
          </header>
          <div class="piste" id="piste" tabindex="0" role="group" aria-label="Tenues du moment">
            {selection.map((p) => <ProductCard product={p} sizes="(min-width: 900px) 24vw, 68vw" />)}
          </div>
          <div class="ourlet-zone"><div class="ourlet" id="ourlet"></div></div>
        </div>
      </div>
    </section>

    <section class="rubriques" id="rubriques" data-fil="0.988 0.5">
      <h2 data-monte>Toutes les rubriques</h2>
      <div class="vitrine" id="vitrine" aria-hidden="true">
        <div class="vitrine-photo" id="vitrine-photo"></div>
        <div class="vitrine-texte"><b id="vitrine-nom"></b><span id="vitrine-prix"></span></div>
      </div>
      <div class="univers" id="univers">
        {colonnes.map((c) => (
          <div>
            <h3><a class="univers-titre" href={c.href}>{c.name}</a></h3>
            {c.rubriques.map((r) => (
              <a href={`/boutique/${r.slug}`} data-photo={r.photo}>
                <Photo class="vignette" src={r.cover.image} alt="" sizes="88px" style={`object-position: ${focus(r.cover)}`} />
                <b>{r.name}</b>
                <span>dès {fcfa(r.from)}</span>
              </a>
            ))}
          </div>
        ))}
      </div>
    </section>

    {duo && (
      <section class="deux" id="deux">
        <h2 data-monte>À porter à deux</h2>
        <p>Le même tissu pour lui et pour elle.</p>
        <div class="deux-scene" data-fil="0.995 0.5; 0.005 0.5">
          <a class="deux-photo" id="deux-photo" href={`/produit/${duo.products[0].slug}`} aria-label={duo.products[0].name}>
            {duo.products.map((p, i) => (
              <Photo class={i === 0 ? 'on' : undefined} src={p.image} alt="" sizes="(min-width: 500px) 27rem, 92vw" />
            ))}
          </a>
        </div>
        <div class="teintes" id="teintes" role="group" aria-label="Couleur de l'ensemble">
          {duo.products.map((p, i) => (
            <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-href={`/produit/${p.slug}`} data-nom={p.name}>{couleur(p.name)}</button>
          ))}
        </div>
        <p class="prix">{fcfa(duo.from)}</p>
      </section>
    )}

    <section class="commander" data-fil="0.012 0.62">
      <h2 data-monte>Comment commander</h2>
      <ol class="etapes">
        <li><span><b>Choisissez</b> votre tenue et votre taille.</span></li>
        <li><span><b>Envoyez</b> le récapitulatif sur WhatsApp, il s'écrit tout seul.</span></li>
        <li><span><b>Recevez</b> votre commande, et payez à la livraison ou par Wave.</span></li>
      </ol>
      <div class="fin"><a class="noeud" id="noeud" href={`https://wa.me/${sales}`} target="_blank" rel="noreferrer">Écrire à TEBBY sur WhatsApp</a></div>
    </section>
  </div>

  <div class="apercu" id="apercu" aria-hidden="true"><img id="apercu-img" alt="" /></div>

  <script>
    const $ = (id: string) => document.getElementById(id)!;
    const calme = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const large = matchMedia('(min-width: 900px)');
    const accueil = document.querySelector<HTMLElement>('.accueil')!;

    document.getElementById('intro')?.addEventListener('click', (e) => (e.currentTarget as HTMLElement).remove());

    /* Le fil : les ancrages viennent des sections, le tracé suit la page */
    const or = $('fil-or') as unknown as SVGPathElement;
    const ombre = $('fil-ombre');
    const aiguille = $('aiguille');
    const noeud = $('noeud');
    let total = 0;
    let table: { x: number; y: number; bas: number }[] = [];

    function ancrages() {
      const base = accueil.getBoundingClientRect();
      const points: [number, number][] = [];
      accueil.querySelectorAll<HTMLElement>('[data-fil]').forEach((el) => {
        const r = el.getBoundingClientRect();
        const brut = (!large.matches && el.dataset.filM) || el.dataset.fil!;
        brut.split(';').forEach((c) => {
          const [x, y] = c.trim().split(' ').map(Number);
          points.push([r.left - base.left + r.width * x, r.top - base.top + r.height * y]);
        });
      });
      const n = noeud.getBoundingClientRect();
      points.push([n.left - base.left + n.width / 2, n.top - base.top]);
      return points;
    }

    function tracer() {
      const m = ancrages();
      let d = `M${m[0][0]} ${m[0][1]}`;
      for (let i = 0; i < m.length - 1; i++) {
        const a = m[i - 1] ?? m[i];
        const b = m[i];
        const c = m[i + 1];
        const e = m[i + 2] ?? c;
        d += `C${b[0] + (c[0] - a[0]) / 6} ${b[1] + (c[1] - a[1]) / 6} ${c[0] - (e[0] - b[0]) / 6} ${c[1] - (e[1] - b[1]) / 6} ${c[0]} ${c[1]}`;
      }
      or.setAttribute('d', d);
      ombre.setAttribute('d', d);
      total = or.getTotalLength();
      or.style.strokeDasharray = String(total);
      let bas = -Infinity;
      table = Array.from({ length: 401 }, (_, i) => {
        const p = or.getPointAtLength((total * i) / 400);
        bas = Math.max(bas, p.y);
        return { x: p.x, y: p.y, bas };
      });
    }

    function avancer() {
      if (calme) {
        or.style.strokeDashoffset = '0';
        aiguille.style.display = 'none';
        noeud.classList.add('noue');
        return;
      }
      const reste = document.documentElement.scrollHeight - innerHeight - scrollY;
      const fin = Math.min(1, Math.max(0, 1 - reste / (innerHeight * 0.5)));
      const cible = -accueil.getBoundingClientRect().top + innerHeight * (0.62 + 0.38 * fin) + (fin === 1 ? innerHeight : 0);
      let i = 0;
      while (i < 400 && table[i + 1].bas <= cible) i++;
      or.style.strokeDashoffset = String(total * (1 - i / 400));
      aiguille.setAttribute('cx', String(table[i].x));
      aiguille.setAttribute('cy', String(table[i].y));
      noeud.classList.toggle('noue', i >= 398);
    }

    /* Tenues du moment : la piste avance avec le défilement sur ordinateur */
    const moment = $('moment');
    const piste = $('piste');
    const ourlet = $('ourlet');
    let course = 0;

    function installerPiste() {
      const actif = large.matches && !calme;
      moment.classList.toggle('pin', actif);
      moment.style.height = '';
      piste.style.transform = '';
      course = actif ? Math.max(0, piste.scrollWidth - innerWidth) : 0;
      if (actif) moment.style.height = `${innerHeight + course}px`;
    }

    function piloterPiste() {
      if (!course) return;
      const p = Math.min(1, Math.max(0, -moment.getBoundingClientRect().top / course));
      piste.style.transform = `translate3d(${-course * p}px,0,0)`;
      ourlet.style.transform = `scaleX(${p})`;
    }

    /* Rubriques au doigt : la ligne active choisit la photo de la vitrine */
    const enVitrine = matchMedia('(hover: none) and (max-width: 639px) and (min-height: 500px)');
    const liens = [...document.querySelectorAll<HTMLAnchorElement>('#univers a[data-photo]')];
    const cadre = $('vitrine');
    const nom = $('vitrine-nom');
    const prix = $('vitrine-prix');
    let actif = -1;

    function monterVitrine() {
      if (!enVitrine.matches || $('vitrine-photo').childElementCount) return;
      liens.forEach((a) => {
        const img = new Image();
        img.src = a.dataset.photo!;
        img.alt = '';
        img.loading = 'lazy';
        $('vitrine-photo').append(img);
      });
      actif = -1;
    }

    function vitrine() {
      if (!enVitrine.matches) return;
      const bas = cadre.getBoundingClientRect().bottom;
      const liste = $('univers').getBoundingClientRect();
      const libre = innerHeight - bas;
      const avance = Math.min(1, Math.max(0, (bas - liste.top) / Math.max(1, liste.height - libre)));
      const repere = bas + 40 + avance * (libre - 90);
      let i = 0;
      let ecart = Infinity;
      liens.forEach((a, n) => {
        const r = a.getBoundingClientRect();
        const d = Math.abs(r.top + r.height / 2 - repere);
        if (d < ecart) {
          ecart = d;
          i = n;
        }
      });
      const r = liens[i].getBoundingClientRect();
      cadre.style.setProperty('--lien', `${Math.max(0, r.top + r.height / 2 - cadre.getBoundingClientRect().top - 8)}px`);
      if (i === actif) return;
      actif = i;
      liens.forEach((a, n) => a.classList.toggle('actif', n === i));
      [...$('vitrine-photo').children].forEach((im, n) => im.classList.toggle('on', n === i));
      nom.textContent = liens[i].querySelector('b')!.textContent;
      prix.textContent = liens[i].querySelector('span')!.textContent;
    }

    /* Photo qui suit la souris dans les rubriques */
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const apercu = $('apercu');
      const image = $('apercu-img') as HTMLImageElement;
      const univers = $('univers');
      univers.addEventListener('pointerover', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-photo]');
        if (!a) return;
        image.src = a.dataset.photo!;
        apercu.classList.add('on');
      });
      univers.addEventListener('pointerleave', () => apercu.classList.remove('on'));
      univers.addEventListener('pointermove', (e) => {
        const x = Math.min(e.clientX + 24, innerWidth - 260);
        const y = Math.min(Math.max(e.clientY - 150, 70), innerHeight - 340);
        apercu.style.transform = `translate(${x}px,${y}px)`;
      });
    }

    /* À porter à deux : changer de couleur change la photo et le lien */
    document.getElementById('teintes')?.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      const boutons = [...$('teintes').children] as HTMLButtonElement[];
      const lien = $('deux-photo') as HTMLAnchorElement;
      boutons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      [...lien.children].forEach((im, n) => im.classList.toggle('on', boutons[n] === b));
      lien.href = b.dataset.href!;
      lien.setAttribute('aria-label', b.dataset.nom!);
    });

    let attente = false;
    function defiler() {
      if (attente) return;
      attente = true;
      requestAnimationFrame(() => {
        attente = false;
        avancer();
        piloterPiste();
        vitrine();
      });
    }

    function caler() {
      document.documentElement.style.setProperty('--tete', `${document.querySelector<HTMLElement>('.site-header')!.offsetHeight}px`);
      monterVitrine();
      installerPiste();
      tracer();
      defiler();
    }

    addEventListener('scroll', defiler, { passive: true });
    addEventListener('resize', caler);
    addEventListener('load', caler);
    document.fonts?.ready.then(caler);
    caler();
  </script>
</Base>
